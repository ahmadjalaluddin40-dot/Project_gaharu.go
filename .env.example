# Public Sanity dataset. Do not put private API tokens in VITE_ variables.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_PUBLIC_SITE_URL=https://gaharu.org
VITE_NETLIFY_FORMS_ENABLED=false
# Optional: restricted browser key for the official Google Maps Embed API.
# Without this key the site uses Google's public embed URL.
VITE_GOOGLE_MAPS_EMBED_KEY=
# Optional: after placing the official logo in public/, point to it here.
VITE_GAHARU_LOGO_URL=

# Supabase database (form submissions). The `anon` key is public by design and
# safe for the browser as long as RLS policies are enabled on the table.
# NEVER put the `service_role` secret here or in any VITE_ variable: Vite
# inlines VITE_ values into the public bundle.
VITE_SUPABASE_URL=https://kzfhaymbvljocabwtach.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt6ZmhheW1idmxqb2NhYnd0YWNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA0OTcwMDYsImV4cCI6MjEwNjA3MzAwNn0.AnZn9OSxg40Y3G27G5zok3eWxdY17ClVW3n7WCtaTmw
VITE_SUPABASE_MESSAGES_TABLE=contact_messages

# Used only by Sanity Studio / the seed script, never exposed to the browser.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_API_WRITE_TOKEN=